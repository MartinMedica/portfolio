---
import LanguageSwitcher from "./LanguageSwitcher.astro";
const { t } = Astro.props;
---

<header
  class="flex w-full flex-col items-center justify-center py-5 md:absolute md:w-8/10"
>
  <nav class="flex flex-row items-center gap-4 opacity-90 md:gap-10">
    <a href="#top" class="hover:text-yellow-200">{t("header.home")}</a>
    <a href={`#${t("experience.id")}`} class="hover:text-yellow-200"
      >{t("header.experience")}</a
    >
    <a href={`#${t("projects.id")}`} class="hover:text-yellow-200"
      >{t("header.projects")}</a
    >
  </nav>
  <div class="md:absolute md:top-4 md:right-0">
    <LanguageSwitcher />
  </div>
</header>
