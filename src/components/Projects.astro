---
import NextJs from "./icons/NextJs.astro";
import Tailwind from "./icons/Tailwind.astro";
import AstroIcon from "./icons/AstroIcon.astro";
import AWS from "./icons/AWS.astro";
import Link from "./icons/Link.astro";
import React from "./icons/React.astro";
import TypeScript from "./icons/TypeScript.astro";
import HuggingFace from "./icons/HuggingFace.astro";
import GitHub from "./icons/GitHub.astro";

const TAGS = {
  TAILWIND: {
    name: "Tailwind CSS",
    class: "bg-white text-sky-500",
    icon: Tailwind,
  },
  NEXT: {
    name: "Next.Js",
    class: "bg-black text-white",
    icon: NextJs,
  },
  ASTRO: {
    name: "Astro",
    class: "bg-black text-red-400",
    icon: AstroIcon,
  },
  AWS: {
    name: "AWS",
    class: "bg-black text-orange-400",
    icon: AWS,
  },
  REACT: {
    name: "React",
    class: "bg-sky-950 text-sky-300",
    icon: React,
  },
  TYPESCRIPT: {
    name: "TypeScript",
    class: "bg-blue-950 text-blue-300",
    icon: TypeScript,
  },
  TRANSFORMERS: {
    name: "Transformers.js",
    class: "bg-yellow-950 text-yellow-200",
    icon: HuggingFace,
  },
};

const { t } = Astro.props;

const PROJECTS = [
  {
    title: t("projects.browserAi.title"),
    description: t("projects.browserAi.desc"),
    link: "https://browser-ai.martinmedica.com/",
    github: "https://github.com/MartinMedica/browser-ai",
    screenshot: "/projects/browserai.webp",
    tags: [TAGS.REACT, TAGS.TYPESCRIPT, TAGS.TRANSFORMERS],
  },
  {
    title: t("projects.transcribe.title"),
    description: t("projects.transcribe.desc"),
    link: "https://www.transcribe.martinmedica.com",
    screenshot: "/projects/transcribe.webp",
    tags: [TAGS.NEXT, TAGS.TAILWIND],
  },
  {
    title: t("projects.shorten.title"),
    description: t("projects.shorten.desc"),
    link: "https://shorten.martinmedica.com/",
    screenshot: "/projects/shorten.webp",
    tags: [TAGS.ASTRO, TAGS.AWS],
  },
  // {
  //   title: "Tapir",
  //   description: "Tienda de Arte",
  //   link: "https://www.tapir.uy",
  //   screenshot: "/projects/tapir.webp",
  //   tags: [TAGS.NEXT, TAGS.TAILWIND],
  // },
];
---

<div class="flex flex-col gap-y-16">
  {
    PROJECTS.map(({ title, description, link, github, screenshot, tags }) => (
      <article class="group flex flex-col gap-8 md:flex-row">
        <div class="w-full md:w-1/2">
          <img
            class="rounded shadow-2xl shadow-white/10 transition group-hover:scale-105"
            src={screenshot}
            alt="Captura de pantalla del proyecto"
          />
        </div>
        <div class="w-full md:w-1/2 md:max-w-lg">
          <h3 class="mb-2 text-2xl font-semibold text-yellow-200">{title}</h3>
          <ul class="mb-4 flex flex-row gap-x-4">
            {tags.map((tag) => (
              <li>
                <span
                  class={`flex gap-x-2 rounded-full text-xs ${tag.class} px-2 py-1`}
                >
                  <tag.icon class="size-4" /> {tag.name}
                </span>
              </li>
            ))}
          </ul>
          <p class="mb-4 text-pretty">{description}</p>
          <div class="flex flex-wrap gap-3">
            <a
              class="flex w-40 items-center justify-center gap-x-3 rounded-xl border border-white/10 bg-white/5 px-2 py-2 transition hover:scale-105 hover:bg-white/10"
              href={link}
              target="_blank"
              rel="noopener noreferrer"
            >
              <Link />
              Preview
            </a>
            {github && (
              <a
                class="flex w-40 items-center justify-center gap-x-3 rounded-xl border border-white/10 bg-white/5 px-2 py-2 transition hover:scale-105 hover:bg-white/10"
                href={github}
                target="_blank"
                rel="noopener noreferrer"
              >
                <GitHub class="size-5" />
                GitHub
              </a>
            )}
          </div>
        </div>
      </article>
    ))
  }
</div>
