---
import Badge from "./Badge.astro";
import SocialPill from "./SocialPill.astro";
import LinkedIn from "./icons/LinkedIn.astro";
import GitHub from "./icons/GitHub.astro";
import Mail from "./icons/Mail.astro";

const { t } = Astro.props;
---

<h1
  class="flex flex-row flex-wrap items-center gap-x-4 text-5xl font-bold md:text-6xl lg:text-7xl"
>
  Martín Médica <a
    href="https://www.linkedin.com/in/martinmedica/"
    target="_blank"
    rel="noopener noreferrer"><Badge>{t("hero.available")}</Badge></a
  >
</h1>
<h2 class="mt-2 text-base font-normal text-yellow-200/90">
  {t("hero.role")}
</h2>
<p class="mt-3 max-w-3xl text-base leading-relaxed text-white/80">
  {t("hero.description")}
  <span class="text-sky-200/90">{t("hero.location")}</span>
</p>
<ul class="mt-8 flex flex-wrap gap-x-4 gap-y-3">
  <li>
    <SocialPill href="https://www.linkedin.com/in/martinmedica/">
      <LinkedIn class="size-4 md:size-6" />
      LinkedIn
    </SocialPill>
  </li>
  <li>
    <SocialPill href="https://github.com/MartinMedica">
      <GitHub class="size-4 md:size-6" />
      GitHub
    </SocialPill>
  </li>
  <li>
    <SocialPill href="mailto:martinmedica@gmail.com">
      <Mail class="size-4 md:size-6" />
      martinmedica@gmail.com
    </SocialPill>
  </li>
</ul>
