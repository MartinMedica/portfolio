---
import { getLangFromUrl } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const isEnglish = lang === "en";
---

<nav
  aria-label={isEnglish ? "Language" : "Idioma"}
  class="inline-flex items-center rounded-full border border-white/15 bg-slate-900/60 p-1 text-xs font-semibold shadow-sm backdrop-blur"
>
  <a href="/" lang="en" aria-current={isEnglish ? "page" : undefined}
    class:list={["rounded-full px-3 py-1 transition", isEnglish ? "bg-yellow-200 text-slate-950" : "text-white/70 hover:text-yellow-200"]}>English</a>
  <a href="/es" lang="es" aria-current={!isEnglish ? "page" : undefined}
    class:list={["rounded-full px-3 py-1 transition", !isEnglish ? "bg-yellow-200 text-slate-950" : "text-white/70 hover:text-yellow-200"]}>Español</a>
</nav>
