---
// components/LanguageSwitcher.astro
import { getLangFromUrl } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const isEnglish = lang === "en";
const href = isEnglish ? "/" : "/en";
---

<a
  href={href}
  aria-label={isEnglish ? "Switch to Spanish" : "Switch to English"}
  class="group relative inline-flex h-8 w-[74px] items-center rounded-full border border-white/15 bg-slate-900/60 px-1 text-[11px] font-semibold text-white/70 shadow-sm backdrop-blur transition hover:border-yellow-200/60"
>
  <span
    class:list={[
      "absolute left-1 h-6 w-8 rounded-full bg-yellow-200 shadow-sm transition-transform duration-200 ease-out",
      isEnglish && "translate-x-[34px]",
    ]}></span>

  <span class="relative z-10 grid w-full grid-cols-2 text-center leading-6">
    <span class={isEnglish ? "text-white/50" : "text-slate-950"}>ES</span>
    <span class={isEnglish ? "text-slate-950" : "text-white/50"}>EN</span>
  </span>
</a>
