---
import ExperienceItem from "./ExperienceItem.astro";

const { t } = Astro.props;
const EXPERIENCE = [
  {
    date: t("experience.ml.date"),
    title: t("experience.ml.title"),
    description: t("experience.ml.desc"),
  },
  {
    date: t("experience.tata.date"),
    title: t("experience.tata.title"),
    description: t("experience.tata.desc"),
  },
];
---

<ol class="border-default relative border-s">
  {
    EXPERIENCE.map((experience) => (
      <li class="ms-4 mb-10">
        <ExperienceItem {...experience} />
      </li>
    ))
  }
</ol>
